# === Client (VITE_*) — publishable only ===
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# === Server / Supabase (also set as Lovable secrets; do not prefix VITE_) ===
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
# SUPABASE_SERVICE_ROLE_KEY=

# === Solana ===
SOLANA_RPC=https://solana-rpc.publicnode.com
HELIUS_API_KEY=YOUR_HELIUS_API_KEY
# Path to Solana keypair JSON (mint authority) OR inline JSON array — server-only secret
KEY_MINT_AUTHORITY_JSON=./key-mint-authority.json

# === Payout bot wake-up webhook (server-side only; never VITE_*) ===
ZKEY_PAYOUT_WEBHOOK_URL=
ZKEY_PAYOUT_WEBHOOK_KEY=

# === Drizzle migrations (optional) ===
# LOVABLE_DATABASE_URL=
